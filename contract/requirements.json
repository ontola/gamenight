{
  "version": 4,
  "groups": {
    "essential": {
      "label": "Plays smoothly",
      "description": "Required for reliable play"
    },
    "personalisation": {
      "label": "Your player follows you",
      "description": "Optional for compatibility; required for GameNight games"
    },
    "extras": {
      "label": "Party extras",
      "description": "Optional extras for game night"
    }
  },
  "features": {
    "protocol.handshake": {
      "group": "essential",
      "required": true,
      "description": "Connects to GameNight"
    },
    "gameplay.start": {
      "group": "essential",
      "required": true,
      "description": "Starts promptly in gameplay"
    },
    "gameplay.pause": {
      "group": "essential",
      "required": true,
      "description": "Pauses simulation, timers and audio"
    },
    "gameplay.resume": {
      "group": "essential",
      "required": true,
      "description": "Resumes the paused game correctly"
    },
    "input.back": {
      "group": "essential",
      "required": true,
      "description": "Back / Select without bouncing"
    },
    "input.identity": {
      "group": "essential",
      "required": true,
      "description": "Correct controller per player"
    },
    "presentation.prewarm": {
      "group": "essential",
      "required": true,
      "description": "Hidden, silent and ready before playing"
    },
    "presentation.frame": {
      "group": "essential",
      "required": true,
      "description": "Game renders successfully"
    },
    "gameplay.switch": {
      "group": "essential",
      "required": true,
      "description": "Switches games without stray focus, audio or processes"
    },
    "process.disconnect": {
      "group": "essential",
      "required": true,
      "description": "Closes when the host disconnects"
    },
    "profile.identity": {
      "group": "personalisation",
      "required": false,
      "description": "Player name sync"
    },
    "profile.colors": {
      "group": "personalisation",
      "required": false,
      "description": "Skin and clothing colour sync"
    },
    "profile.face": {
      "group": "personalisation",
      "required": false,
      "description": "Drawn face and hat sync"
    },
    "party.round_end": {
      "group": "extras",
      "required": false,
      "description": "Reports round completion without ending the session"
    },
    "party.results": {
      "group": "extras",
      "required": false,
      "description": "Scores and results"
    },
    "party.replay": {
      "group": "extras",
      "required": false,
      "description": "Replay voting"
    },
    "party.settings": {
      "group": "extras",
      "required": false,
      "description": "Live game settings"
    },
    "gameplay.continuous": {
      "group": "essential",
      "required": true,
      "description": "Rounds repeat until players explicitly switch games"
    }
  }
}
