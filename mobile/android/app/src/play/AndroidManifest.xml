<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Play handles updates; this build cannot install downloaded APKs. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove"/>
    <application>
        <receiver android:name=".InstallReceiver" tools:node="remove"/>
        <receiver android:name=".UpdatedReceiver" tools:node="remove"/>
    </application>
</manifest>
