extends SceneTree
var failed := false
func _initialize(): call_deferred("run")
func check(ok: bool, label: String):
	if not ok: failed=true; push_error(label)
func run():
	var sdk = load("res://addons/gamenight/gamenight.gd").new()
	sdk.game_id="test"
	sdk._handle({"type":"prepare","game":"test","session":"s1","seats":[{"index":0,"controller":"pad:B"},{"index":1,"controller":"pad:A"}],"players":[]})
	sdk.notify_ready("s1")
	sdk._handle({"type":"start","session":"s1"})
	sdk._handle({"type":"controller_frame","controllers":[{"controller":"pad:A","axes":[32767,0,0,0,0,0],"buttons":4},{"controller":"pad:B","axes":[-32767,0,0,0,0,0],"buttons":1}]})
	check(sdk.axis(sdk.frame_for_seat(0),0)==-1.,"seat 0 follows its opaque token, not enumeration")
	check(sdk.button(sdk.frame_for_seat(1),2),"seat 1 gets its own buttons")
	sdk._handle({"type":"pause","session":"stale"})
	check(sdk.phase=="running","stale lifecycle rejected")
	sdk._handle({"type":"pause","session":"s1"})
	check(sdk.frame_for_seat(0).is_empty(),"pause yields neutral input")
	sdk._handle({"type":"resume","session":"s1"})
	sdk._handle({"type":"party_updated","session":"s1","seats":[{"index":0,"controller":"pad:A"}],"players":[{"name":"Updated"}],"presence":[]})
	check(sdk.axis(sdk.frame_for_seat(0),0)==1.,"live seat changes remap immediately")
	check(sdk.party.players[0].name=="Updated","live profiles delivered")
	var renamed := []
	sdk.players_updated.connect(func(players): renamed.append_array(players))
	sdk.party.players=[{"id":"a","name":"Rocket"}]
	sdk._handle({"type":"players_updated","session":"stale","players":[{"id":"a","name":"Joep"}]})
	check(renamed.is_empty(),"stale players_updated ignored")
	sdk._handle({"type":"players_updated","session":"s1","players":[{"id":"a","name":"Joep","avatar":"face"}]})
	check(renamed.size()==1 and sdk.party.players[0].name=="Joep" and sdk.phase=="running","players_updated renames in place")
	sdk._frame_at=Time.get_ticks_msec()-251
	check(sdk.frame_for_seat(0).is_empty(),"lost input times out")
	sdk._frame_at=Time.get_ticks_msec()
	sdk._handle({"type":"controller_frame","controllers":[{"controller":"pad:A","axes":[3000,-32767,0,0,0,32767],"buttons":1}]})
	check(is_equal_approx(sdk.stick(sdk.frame_for_seat(0)).length(),1.0) and sdk.stick({"axes":[3000,-3000]})==Vector2.ZERO,"stick applies a radial deadzone")
	check(is_equal_approx(sdk.trigger(sdk.frame_for_seat(0),1),1.0),"right trigger reads 0 to 1")
	sdk._physics_process(0)
	check(sdk.just_pressed(0,sdk.BUTTON_A),"a new press is an edge")
	sdk._physics_process(0)
	check(not sdk.just_pressed(0,sdk.BUTTON_A),"a held press is one edge")
	sdk._handle({"type":"pause","session":"s1"})
	check(not sdk.frame_for_seat(0,true).is_empty(),"menus can read input while paused")
	sdk._handle({"type":"resume","session":"s1"})
	sdk._physics_process(0)
	check(not sdk.just_pressed(0,sdk.BUTTON_A),"a press held through resume must be released first")
	sdk._handle({"type":"controller_frame","controllers":[{"controller":"pad:A","axes":[0,0,0,0,0,0],"buttons":0}]})
	sdk._physics_process(0)
	sdk._handle({"type":"controller_frame","controllers":[{"controller":"pad:A","axes":[0,0,0,0,0,0],"buttons":1}]})
	sdk._physics_process(0)
	check(sdk.just_pressed(0,sdk.BUTTON_A),"released and pressed again is an edge")
	var seen := []
	sdk.player_settings_changed.connect(func(id, values): seen.append([id, values]))
	sdk._handle({"type":"player_settings","game":"test","player_id":"p1","values":{"sensitivity":150.0,"character":"cat"}})
	check(seen.size()==1 and seen[0][0]=="p1","player settings are announced")
	check(sdk.player_setting("p1","sensitivity") is int and sdk.player_setting("p1","sensitivity")==150,"player numbers are ints")
	check(sdk.player_setting("p1","character")=="cat" and sdk.player_setting("p2","character","frog")=="frog","player settings are per player with a fallback")
	var progress := []
	sdk.player_data_changed.connect(func(id, data): progress.append([id, data]))
	check(sdk.player_data("p1").is_empty(),"no saved progress is an empty dictionary")
	sdk._handle({"type":"player_data","game":"test","player_id":"p1","data":{"unlocks":["rocket"]},"revision":3})
	check(progress.size()==1 and sdk.player_data("p1")["unlocks"]==["rocket"],"saved progress is announced and kept")
	sdk.party = {"players":[{"id":"p1"},{"id":"p2"}]}
	sdk._handle({"type":"player_data","game":"test","player_id":"p2","data":{"unlocks":["shield","rocket"]},"revision":1})
	check(sdk.party_union()==["rocket","shield"],"the party shares unlocks for the session")
	sdk.unlock_for_present("laser")
	check(sdk.player_data("p1")["unlocks"]==["rocket","laser"] and sdk.player_data("p2")["unlocks"].has("laser"),"a shared unlock is saved for everyone present")
	sdk._handle({"type":"dispose","session":"s1"})
	check(sdk.session.is_empty() and sdk.phase=="idle","dispose clears session")
	sdk.free()
	var offline = load("res://addons/gamenight/gamenight.gd").new()
	var addr := OS.get_environment("GAMENIGHT_ADDR")
	OS.set_environment("GAMENIGHT_ADDR","")
	root.add_child(offline)
	check(offline._socket==null and not offline.auto_reconnect,"a hand-started game stays offline")
	OS.set_environment("GAMENIGHT_ADDR",addr)
	offline.queue_free()
	DirAccess.make_dir_recursive_absolute("user://phone-src/img")
	var page := FileAccess.open("user://phone-src/index.html",FileAccess.WRITE); page.store_string("<p>hi</p>"); page.close()
	var font := FileAccess.open("user://phone-src/img/a.ttf",FileAccess.WRITE); font.store_string("x"); font.close()
	var phone = load("res://addons/gamenight/gamenight.gd").new()
	var served: String = phone.declare_companion_folder("user://phone-src")
	check(FileAccess.file_exists(served.path_join("img/a.ttf")) and FileAccess.file_exists(served.path_join("index.html")),"phone folder is copied to a real directory")
	check(phone._declared_companion.get("root","")==served and phone._declared_companion.get("entry","")=="index.html","phone folder is declared")
	phone.free()
	var screen = load("res://addons/gamenight/screen.gd").new()
	screen._on_focus_in()
	check(screen._epoch==0,"focus has no lifecycle side effect")
	screen.free()
	var art = load("res://addons/gamenight/artwork.gd").new()
	root.add_child(art)
	var base: String = OS.get_environment("ART_TEST_URL")
	check(art.texture(base+"/cover.png")==null,"remote artwork does not block")
	art.texture(base+"/missing.png")
	var deadline := Time.get_ticks_msec()+8000
	while (not art.cache.has(base+"/cover.png") or not art.cache.has(base+"/missing.png")) and Time.get_ticks_msec()<deadline:
		await create_timer(.02).timeout
	check(art.texture(base+"/cover.png")!=null,"HTTP artwork appears after loading")
	check(art.cache.has(base+"/missing.png") and art.texture(base+"/missing.png")==null,"failed download caches title fallback")
	art.queue_free()
	print("GAME_SDK_PASS" if not failed else "GAME_SDK_FAIL")
	quit(1 if failed else 0)
